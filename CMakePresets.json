{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },
    {
      "name": "release",
      "displayName": "Release (tests + benchmarks)",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TICKFORGE_BUILD_BENCH": "OFF" }
    },
    {
      "name": "asan",
      "displayName": "AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TICKFORGE_SANITIZE": "address,undefined",
        "TICKFORGE_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "tsan",
      "displayName": "ThreadSanitizer",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "TICKFORGE_SANITIZE": "thread",
        "TICKFORGE_BUILD_BENCH": "OFF"
      }
    },
    {
      "name": "python",
      "displayName": "Release + Python module",
      "inherits": "release",
      "cacheVariables": { "TICKFORGE_PYTHON": "ON", "TICKFORGE_BUILD_BENCH": "OFF" }
    },
    {
      "name": "cuda",
      "displayName": "Release + CUDA kernel (needs nvcc)",
      "inherits": "release",
      "cacheVariables": { "TICKFORGE_CUDA": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "python", "configurePreset": "python" },
    { "name": "cuda", "configurePreset": "cuda" }
  ],
  "testPresets": [
    { "name": "base", "hidden": true, "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "release", "inherits": "base", "configurePreset": "release" },
    { "name": "debug", "inherits": "base", "configurePreset": "debug" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "base", "configurePreset": "tsan" }
  ]
}
